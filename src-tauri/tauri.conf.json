{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Containers",
  "version": "1.0.0",
  "identifier": "com.containers.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:8081",
    "beforeBuildCommand": "npm run web:export",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Containers",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "shortDescription": "Gestión de alquileres de activos",
    "longDescription": "Aplicación de escritorio nativa (Tauri) para alquileres, mapa, operadores e inventario."
  }
}
